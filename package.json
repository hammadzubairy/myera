{
  "name": "myera",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@myera/mobile",
    "api": "npm run dev --workspace=@myera/api",
    "admin": "npm run dev --workspace=@myera/admin",
    "shared:build": "npm run build --workspace=@myera/shared"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@myera/admin": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
